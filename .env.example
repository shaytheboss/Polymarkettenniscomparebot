# Database (Railway provides this automatically)
DATABASE_URL=postgresql://tennisbot:tennisbot@localhost:5432/tennisbot

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_WEBHOOK_SECRET=random_secret_here

# Live Tennis Scores — get key at https://api-tennis.com
API_TENNIS_KEY=your_api_tennis_key_here

# Polymarket (optional — markets are auto-discovered if blank)
POLYMARKET_API_KEY=

# App
APP_ENV=production
SECRET_KEY=change_me_to_random_string
CORS_ORIGINS=https://your-railway-domain.railway.app

# Scheduler intervals (seconds)
LIVE_SCORES_INTERVAL=15
POLYMARKET_INTERVAL=20
ANALYZER_INTERVAL=30

# Alert thresholds
DEFAULT_MIN_EDGE_PP=5.0
DEFAULT_MAX_MODEL_GAP_PP=15.0
ALERT_DEDUP_MINUTES=15

# Sentry (optional)
SENTRY_DSN=
